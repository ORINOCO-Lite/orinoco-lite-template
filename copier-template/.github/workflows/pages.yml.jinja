name: Publish project Pages

on:
  push:
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: pages
  cancel-in-progress: false

jobs:
  pages:
    if: >-
      ${{
        github.repository != 'con/orinoco-lite-template' &&
        (
          github.event_name == 'workflow_dispatch' ||
          github.ref == format('refs/heads/{0}', github.event.repository.default_branch)
        )
      }}
    permissions:
      contents: write
      pages: write
      id-token: write
    uses: [[ workflow_repository ]]/.github/workflows/orinoco-pages.yml@[[ workflow_sha ]]
    with:
      source-ref: >-
        ${{ github.event_name == 'workflow_dispatch' &&
        github.event.repository.default_branch || github.sha }}
      pixi-version: v0.73.0
      workflow-repository: [[ workflow_repository ]]
      workflow-sha: [[ workflow_sha ]]
