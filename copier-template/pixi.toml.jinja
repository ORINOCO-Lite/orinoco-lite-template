[workspace]
name = "[[ project_slug ]]"
channels = ["conda-forge"]
platforms = [{ platform = "osx-arm64", macos = "14.0" }, "linux-64"]

[dependencies]
python = ">=3.12,<3.13"
copier = "==9.10.3"
hugo = "==0.154.5"
pyyaml = "==6.0.2"

[pypi-dependencies]
orinoco-lite = { url = "[[ package_url ]]#sha256=[[ package_sha256 ]]" }
datalad = ">=1.6.2,<2"

[tasks]
projection-update = "mkdir -p generated && orinoco projection update"
validate = { depends-on = ["projection-update"], cmd = "orinoco validate" }
build = { depends-on = ["projection-update"], cmd = "orinoco build --destination build/site --base-url /" }
verify-local-preview = { depends-on = ["build"], cmd = "python .orinoco-lite/tools/verify_local_preview.py build/site" }
verify-build = { depends-on = ["verify-local-preview"] }
build-pages = { depends-on = ["projection-update"], cmd = "python .orinoco-lite/tools/build_pages.py build/pages" }
serve = "orinoco serve --directory build/site --port 8765"
apply-editor-bundle = "orinoco editor apply"
verify-hugo = "python .orinoco-lite/tools/verify_hugo.py --version 0.154.5 --extended"
verify-release-selection = "python .orinoco-lite/tools/verify_template_ownership.py"
